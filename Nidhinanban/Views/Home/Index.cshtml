@{
    ViewData["Title"] = "Home Page";
}
   
<div class="text-center">
    <h1 class="text-center" id="greeting"> @LoggedInUserModel.UserName !</h1>
         <div class="row justify-content-center my-5">
            <div class="col-lg-3 col-md-4 col-sm-6 col-10 my-3 " >
                <div class="custom-bg border  h-100">
                    <img width="90" height="90" src="https://img.icons8.com/fluency/144/accounting.png" alt="accounting" class="mx-auto my-4"/>
                    <h4 class="my-3">Interest Calculator</h4>
                    <h6 class="text-secondary">Calculate The Interest</h6>
                        <a asp-controller="Intrest" asp-action="Intrestcalc" class="btn btn-outline-purple w-75 mx-auto border my-3">Open Calculator</a>
                    </div>
                </div>
            <div class="col-lg-3 col-md-4 col-sm-6 col-10 my-3 " >
                <div class="custom-bg border border-10  h-100">
                    <img width="90" height="90" src="https://img.icons8.com/fluency/144/gender-neutral-user--v1.png" alt="gender-neutral-user--v1" class="mx-auto my-4"/>
                    <h4 class="my-3">Customer</h4>
                    <h6 class="text-secondary">Add & Manage Customer </h6>
                    <button class="btn bnt-gradient-primary  w-75 mx-auto border my-3">Open Customer</button>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-4 col-sm-6 col-10 my-3 ">
                <div class="custom-bg border border-10  h-100">
                    <img width="90" height="90" src="https://img.icons8.com/fluency/144/high-importance.png" alt="high-importance" class="mx-auto my-4"/>
                    <h4 class="my-3">Late Payment Fines</h4>
                    <h6 class="text-secondary text-center mx-auto">Calculate penalites for late payments</h6>
                    <button class="btn btn-outline-light text-black w-75 mx-auto border my-3">Open Calculator</button>
                </div>
            </div>
        </div> 

       <script>
        var currenttime = new Date();
        var now = currenttime.getHours();
        var component = document.getElementById("greeting");
        if (now < 12) {
            component.innerHTML = "Good Morning "+component.innerHTML;
        } else if (now < 17) {
            component.innerHTML = "Good Afternoon "+component.innerHTML;
        }
        else if(now < 20){
            component.innerHTML = "Good Evening "+component.innerHTML;
        }
        else {
            component.innerHTML = "Good Night" +component.innerHTML;
        }
    </script>
</div>