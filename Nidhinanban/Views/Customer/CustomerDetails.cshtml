@model List<ViewCustomer>
@{
    ViewData["Title"] = "CustomerDetails";
}
<style>
 .editcontainer{
    margin-left:10%;
 }
 .editcontainer:hover{
    display:"block";
    
 }
</style>
<div>
    <button class="btn btn-outline-light text-black border rounded-circle " onclick="back()" >
        <img width="25" height="30"  src="https://img.icons8.com/plumpy/50/back.png" alt="back"/>
    </button>
    <div class="d-flex float-end flex-row-reverse editcontainer"><img src="https://img.icons8.com/plumpy/50/back.png" alt="edit"/>
    <div class="d-flex justify-content-evenly editcontainer">
    <div style="display: none;" class="editcontainer">
    <img src="https://img.icons8.com/plumpy/50/back.png" alt="view"/> <img src="https://img.icons8.com/plumpy/50/back.png" alt="delete"/>
    </div>
    </div>
    </div>
    <div class="modal" id="Profilemodal">
        <div class="modal-dailog">
            <div class="model-content">
                <h3>Hello</h3>
            </div>
        </div>
    </div>

    <div class="card col-10 mx-auto">
        <div class="card-header">
            <div class="d-flex justify-content-center">
                <h3 class="fw-bolder text-uppercase">Customer Details</h3>
            </div>
        </div>
        <div class="card-body">
            @* Name And Image Section *@
            <div class="row align-items-center">
                <!-- Image Column -->
                <div class="col-sm-12 col-md-6 text-center mb-3 mb-md-0">
                    <img src="/getimg/GetImageProxy/@Model[0].customerid/profile" style="height:120px; max-height: 120px; object-fit: cover; border-radius: 50%;" class="rounded"/>
                </div>
                <!-- Text Column -->
                <div class="col-sm-12 col-md-6 ">

                    <div class="mb-3 d-flex justify-content-center">
                        <label>Name:</label><label>@Model[0].customername</label></div>
                </div>
            </div>

            @* Phone Number And Address Section *@
            <div class="row align-content-center mt-sm-2 mt-lg-2">
                <div class="col-sm-12 col-md-6 col-lg-6 justify-content-center ">
                    <div class="mb-3 d-flex justify-content-center"><label class=" ">Phone
                            Number:</label><label>@Model[0].cutomerphonenumber</label></div>
                </div>
                <div class="col-sm-12 col-md-6 ">

                    <div class="mb-3 d-flex justify-content-center">
                        <label>Address:</label><label>@Model[0].customeraddress</label></div>
                </div>

            </div>

            @* House Image Section *@
            <div class="row mt-sm-2 mt-lg-3 ">
                <hr />
                <h3 class="text-center text-uppercase text-black fw-bolder ">House Image</h3>
                <hr />
                <div class="d-flex justify-content-center">
                    <img class="img-fluid" style="height:200px; max-height: 200px; object-fit: fit;"
                        src="/getimg/GetImageProxy/@Model[0].customerid/house" data-bs-toogle="modal" data-bs-target="#Profilemodal" />
                </div>
            </div>

            @* Proff Image Section *@
            <div class="row mt-sm-2 mt-lg-3 ">
                <hr />
                <h3 class="text-center text-uppercase fw-bolder">Proff Images</h3>
                <hr />
                <div class="row mt-sm-2 mt-md-5 mt-lg-5 ">
                    <!-- PAN Picture -->
                    <div class="col-sm-12 col-md-6 col-lg-6 d-flex-row justify-content-center">
                        <label>PAN Picture</label>
                        <div style="">
                            <img id="panPic" class="img-fluid w-100 img-thumbnail "
                                style="height:200px; max-height: 200px; object-fit: fit;"
                                src="/getimg/GetImageProxy/@Model[0].customerid/pan")" />
                        </div>

                    </div>

                    <!-- Aadhaar Picture -->
                    <div class="col-sm-12 col-md-6 col-lg-6">
                        <label>Aadhaar Picture</label>
                        <div class="">
                            <img id="aadhaarPic" class="img-fluid img-thumbnail w-100"
                                style="height:200px;max-height: 200px; object-fit: fit;"
                                src="/getimg/GetImageProxy/@Model[0].customerid/aadhar" />
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>
</div>

</div>
</div>
<script>
    function back()
    {
        let type=sessionStorage.getItem("ViewType");
        if(type=="List")
        {
            window.location.href="/Customer/ViewCustomerlist";
        }
        else if(type=="Gird")
        {
            window.location.href="/Customer/ViewCustomer";
        }
        else{
            window.location.href="/Customer/ViewCustomer";
        }
    }
</script>